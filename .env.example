# ===== SOULHEALTH Demo 环境变量（复制为 .env 后填写）=====

# Claude 视觉抽取 + 健康问答（真实模式必填）
ANTHROPIC_API_KEY=

# 模型名（默认 claude-sonnet-4-6，可按贵司账号可用模型调整）
# SOULHEALTH_LLM_MODEL=claude-sonnet-4-6

# EVO2 序列打分（NVIDIA NIM，选填；未配置时打分项如实标记 skipped，
# 但变异位点/等位基因仍来自 Ensembl 实时数据）
NVIDIA_API_KEY=

# 显式离线演示模式：设为 1 才启用演示样例（默认关闭=真实优先）
# SOULHEALTH_MOCK=1

# 生物计算模式覆盖：real（默认）/ mock
# SOULHEALTH_BIOCOMPUTE=real

# 报告中打印真实姓名（默认仅化名；姓名永远只存本地库、不发外部服务）
# SOULHEALTH_REPORT_REAL_NAME=1

# ===== 登录鉴权（阶段五新增）=====

# 登录令牌签名密钥。默认值仅用于本地演示，生产部署务必改为随机长字符串，
# 否则任何人都能伪造登录令牌！生成示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
# SOULHEALTH_SECRET_KEY=

# 登录令牌有效期（小时），默认 12
# SOULHEALTH_TOKEN_TTL_HOURS=12

# 首次启动自动创建的管理员账号（仅当 users 表为空时创建一次）
# SOULHEALTH_ADMIN_USER=admin
# 不设置则随机生成密码并打印到控制台（仅显示一次）；设置后使用固定密码，
# 便于自动化部署，但请确保只有可信人员能读到这个环境变量
# SOULHEALTH_ADMIN_PASSWORD=
